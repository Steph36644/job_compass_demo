# 公开演示。复制为 .env.local 后只填写你自己的项目，不要提交 .env.local。
# 不要使用生产项目，不要填写服务端私钥，不要把供应商 Key 写成 NEXT_PUBLIC_。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅服务端读取。留空时 AI 会提示暂时无法调用，本地台账仍可使用。
JOB_COMPASS_AI_API_KEY=
# 可选。只接受 https://api.openai.com 、api.deepseek.com 、dashscope.aliyuncs.com
JOB_COMPASS_AI_BASE_URL=
JOB_COMPASS_AI_MODEL=
